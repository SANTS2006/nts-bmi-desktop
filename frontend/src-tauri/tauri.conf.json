{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NTS BMI",
  "version": "1.0.0",
  "identifier": "com.ntsdigitalsolutions.bmi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "NTS BMI — Business Management Intelligence",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
  "active": true,
  "targets": [
    "nsis",
    "dmg"
  ],
  "createUpdaterArtifacts": true,
    "category": "Business",
    "shortDescription": "NTS Business Management Intelligence",
    "longDescription": "NTS BMI desktop application for secure business management, finance, projects, communication, users and reporting.",
    "publisher": "NTS Digital Solutions",
    "copyright": "© 2026 NTS Digital Solutions",
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "NTS BMI"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
  "updater": {
    "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3MzJEOTJBMjgxODRFNDMKUldSRFRoZ29LdGt5SituTmQ1YnRFamVEb3NWbzBBOHc3cUlsK1pxd25iaExiUTREekkydFFBelAK",
    "endpoints": [
      "https://github.com/SANTS2006/nts-bmi-desktop/releases/latest/download/latest.json"
    ],
    "requireSignedVersion": true
  }
}
}